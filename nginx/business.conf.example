# Include inside the existing HTTPS server, e.g.:
# /etc/nginx/business/<domain-id>/flowcraft.conf
# Frontend files: /opt/flowcraft/frontend/current (symlink to a version directory).
# Proposed backend port 31008 must match APP_PORT after allocation is checked.
location = /flowcraft {
    return 308 /flowcraft/$is_args$args;
}
location = /flowcraft/healthz {
    proxy_pass http://127.0.0.1:31008;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location ^~ /flowcraft/api/ {
    proxy_pass http://127.0.0.1:31008;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    client_max_body_size 100m;
}
location ^~ /flowcraft/assets/ {
    alias /opt/flowcraft/frontend/assets/;
    expires 1y;
    add_header Cache-Control "public, immutable";
}
location /flowcraft/ {
    alias /opt/flowcraft/frontend/current/;
    try_files $uri $uri/ /flowcraft/index.html;
    add_header Cache-Control "no-cache";
}
