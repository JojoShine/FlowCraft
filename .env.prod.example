COMPOSE_PROJECT_NAME=flowcraft-production
# Release supplies the tested digest. Replace the placeholder before deployment.
APP_IMAGE=ghcr.io/jojoshine/flowcraft@sha256:REPLACE_WITH_RELEASE_DIGEST
# Proposed new port; check server allocation before migrating the current 3800 service.
APP_PORT=31008
BASE_PATH=/flowcraft
DATABASE_URL=postgresql://flowcraft_runtime:CHANGE_ME@host.docker.internal:5432/flowcraft
MIGRATION_DATABASE_URL=postgresql://flowcraft_migrate:CHANGE_ME@host.docker.internal:5432/flowcraft
JWT_SECRET=CHANGE_ME_KEEP_EXISTING_SECRET
JWT_EXPIRES_IN=7d
CLIENT_URL=https://example.com/flowcraft
MINIO_ENDPOINT=host.docker.internal
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=flowcraft
MINIO_ACCESS_KEY=CHANGE_ME_KEEP_EXISTING_KEY
MINIO_SECRET_KEY=CHANGE_ME_KEEP_EXISTING_SECRET
DEEPSEEK_API_KEY=CHANGE_ME_KEEP_EXISTING_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
LOG_LEVEL=info
