generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  username      String?  @unique
  passwordHash  String?
  name          String?
  avatarUrl     String?
  wechatOpenId  String?  @unique
  wechatUnionId String?  @unique
  role          String   @default("admin")
  projectId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contentPreferences ContentPreference[]

  ownedProjects  Project[]      @relation("ProjectOwner")
  assignedTasks  Task[]         @relation("TaskAssignee")
  createdArtifacts Artifact[]   @relation("ArtifactCreator")
  conversations  Conversation[]
  templates      Template[]     @relation("TemplateCreator")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  status      String   @default("discovery")
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]
  drawings Drawing[]
  contentAssets ContentAsset[]

  phases    Phase[]
  tasks     Task[]
  artifacts Artifact[]
  reports   Report[]

  @@index([ownerId])
}

model Phase {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String
  priority    String   @default("med")
  status      String   @default("todo")
  startDate   DateTime?
  dueDate     DateTime?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId     String?
  phase       Phase?   @relation(fields: [phaseId], references: [id])
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  artifacts   Artifact[]
  column      String   @default("todo")
  isMilestone Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([phaseId])
  @@index([column])
  @@index([projectId, status, dueDate])
}

model Artifact {
  id         String   @id @default(uuid())
  name       String
  type       String
  status     String   @default("draft")
  filePath   String?
  content    String?
  shareToken String?  @unique
  taskId       String?
  task         Task?     @relation(fields: [taskId], references: [id])
  templateId   String?
  template     Template? @relation(fields: [templateId], references: [id])
  projectId    String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId  String?
  creator    User?    @relation("ArtifactCreator", fields: [creatorId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@index([type])
}

model Template {
  id           String   @id @default(uuid())
  name         String
  category     String
  description  String?
  content      String
  fileType     String   @default("html")
  outputFormat String   @default("docx")
  usageCount   Int      @default(0)
  creatorId    String?
  creator      User?    @relation("TemplateCreator", fields: [creatorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artifacts Artifact[]
}

model Report {
  id        String   @id @default(uuid())
  type      String
  label     String
  content   String
  date      DateTime
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, projectId, date])
  @@index([projectId])
  @@index([date])
  @@index([type])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String?
  projectId String?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([projectId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  role           String
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Document {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields:[projectId], references:[id], onDelete:Restrict)
  parentId String?
  parent Document? @relation("DocumentTree", fields:[parentId], references:[id], onDelete:Restrict)
  children Document[] @relation("DocumentTree")
  order Int @default(0)
  title String
  searchText String @default("")
  currentVersion Int @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions DocumentRevision[]
  @@index([projectId,deletedAt,parentId,order])
}
model DocumentRevision {
  id String @id @default(uuid())
  documentId String
  document Document @relation(fields:[documentId],references:[id],onDelete:Restrict)
  version Int
  title String
  payload Json
  digest String
  source String
  restoredFrom Int?
  savedAt DateTime @default(now())
  drawingReferences DocumentDrawingReference[]
  assets DocumentRevisionAsset[]
  @@unique([documentId,version])
}
model Drawing {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  title String
  currentVersion Int @default(1)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions DrawingRevision[]
  @@index([projectId,deletedAt,updatedAt])
}
model DrawingRevision {
  id String @id @default(uuid())
  drawingId String
  drawing Drawing @relation(fields:[drawingId],references:[id],onDelete:Restrict)
  version Int
  title String
  payload Json
  digest String
  source String
  restoredFrom Int?
  savedAt DateTime @default(now())
  previewAssetId String?
  previewAsset ContentAsset? @relation("DrawingPreview",fields:[previewAssetId],references:[id],onDelete:Restrict)
  references DocumentDrawingReference[]
  assets DrawingRevisionAsset[]
  @@unique([drawingId,version])
}
model DocumentDrawingReference {
  id String @id @default(uuid())
  documentRevisionId String
  documentRevision DocumentRevision @relation(fields:[documentRevisionId],references:[id],onDelete:Restrict)
  blockId String
  drawingId String
  mode String
  revision Int
  drawingRevision DrawingRevision @relation(fields:[drawingId,revision],references:[drawingId,version],onDelete:Restrict)
  @@unique([documentRevisionId,blockId])
  @@index([drawingId,revision])
}
model ContentAsset {
  id String @id @default(uuid())
  projectId String
  project Project @relation(fields:[projectId],references:[id],onDelete:Restrict)
  creatorId String
  objectKey String @unique
  category String
  originalName String
  mimeType String
  bytes Int
  digest String
  state String
  createdAt DateTime @default(now())
  documentRevisions DocumentRevisionAsset[]
  drawingRevisions DrawingRevisionAsset[]
  previews DrawingRevision[] @relation("DrawingPreview")
  @@index([projectId,state])
}
model DocumentRevisionAsset {
  documentRevisionId String
  assetId String
  documentRevision DocumentRevision @relation(fields:[documentRevisionId],references:[id],onDelete:Restrict)
  asset ContentAsset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  @@id([documentRevisionId,assetId])
}
model DrawingRevisionAsset {
  drawingRevisionId String
  assetId String
  drawingRevision DrawingRevision @relation(fields:[drawingRevisionId],references:[id],onDelete:Restrict)
  asset ContentAsset @relation(fields:[assetId],references:[id],onDelete:Restrict)
  @@id([drawingRevisionId,assetId])
}
model ContentSaveReceipt {
  id String @id @default(uuid())
  kind String
  entityId String
  requestId String
  actorId String
  requestDigest String
  result Json
  createdAt DateTime @default(now())
  @@unique([kind,entityId,requestId])
}
model ContentPreference {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  kind String
  entityId String
  favorite Boolean @default(false)
  lastViewedAt DateTime?
  viewState Json @default("{}")
  @@unique([userId,kind,entityId])
}
